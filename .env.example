# App
APP_PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tdd_db
DB_USER=tdd_user
DB_PASSWORD=tdd_password

# Variables usadas por docker-compose (contenedor MySQL)
MYSQL_DATABASE=tdd_db
MYSQL_USER=tdd_user
MYSQL_PASSWORD=tdd_password
MYSQL_ROOT_PASSWORD=root_password

# Auth JWT
JWT_SECRET=CAMBIA_ESTE_SECRETO_EN_PRODUCCION
JWT_EXPIRES_IN=7d
